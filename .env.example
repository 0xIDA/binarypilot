# LLM (same as strix)
# BINARYPILOT_LLM=openai/gpt-5.4
# LLM_API_KEY=sk-...
# LLM_API_BASE=http://localhost:11434        # local models only
# OpenCode Go (omen-alpha, deepseek-v4-flash, ...) — session headers sent automatically
# BINARYPILOT_LLM=omen-alpha
# LLM_API_BASE=https://opencode.ai/zen/go/v1

# Sandbox image
# BINARYPILOT_IMAGE=ghcr.io/0xida/binarypilot-sandbox:1.2.0

# FlagYard (pick one auth method)
FLAGYARD_USERNAME=
FLAGYARD_PASSWORD=
# FLAGYARD_ACCESS_TOKEN=
# FLAGYARD_API_BASE=https://api.flagyard.com/api

# HackTheBox — App Token from https://app.hackthebox.com/profile/settings
HTB_TOKEN=

# HackTheBox machines (optional) — OpenVPN profile downloaded from the HTB VPN
# page; per-product (machines / starting-point / sherlocks / fortresses /
# seasonal), NOT interchangeable. Mounted read-only into the sandbox, which
# brings the tunnel up itself.
# HTB_VPN_OVPN=/abs/path/to/machines_eu-release-1.ovpn

# Web search (optional)
# PERPLEXITY_API_KEY=
